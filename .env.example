# Copy to .env.local and use your Firebase project's WEB configuration.
# The configured local project is roomsync-9dceb. Runtime values stay ignored.
# Client identifiers are not access control; deploy security rules and indexes.
# Never add service-account private keys or access tokens to frontend config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Keep false until a Storage bucket and its rules are deployed. Firestore,
# Auth, expenses and household features work without optional image uploads.
VITE_FIREBASE_UPLOADS_ENABLED=false
# Automated tests only; never enable on a production deployment:
# VITE_USE_FIREBASE_EMULATORS=true
