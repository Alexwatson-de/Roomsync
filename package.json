{
  "name": "roomsync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npx --yes firebase-tools@13 emulators:exec --only auth,firestore --project demo-roomsync 'playwright test --config playwright.firebase.config.js'",
    "check:firebase": "node scripts/check-firebase.mjs",
    "check:firebase:admin": "node scripts/firebase-admin-status.mjs --report",
    "deploy:firestore": "npx --yes firebase-tools@13 deploy --project roomsync-9dceb --only firestore --non-interactive",
    "test:rules": "npx --yes firebase-tools@13 emulators:exec --only firestore --project roomsync-rules-test 'vitest run --config vitest.rules.config.js'"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
